<Application x:Class="DesktopCalendar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DesktopCalendar"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf">
    <Application.Resources>
        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="我的应用">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu DataContext="{Binding Source={x:Static local:App.TrayViewModel}}">
                    <MenuItem Header="显示主窗口" Command="{Binding ShowCalendarWindowCommand}" />
                    <Separator />
                    <MenuItem Header="隐藏主窗口" Command="{Binding HideCalendarWindowCommand}" />
                    <Separator />
                    <MenuItem Header="鼠标穿透" Command="{Binding TogglePenetrateCommand}" />
                    <Separator />
                    <MenuItem Header="窗口置底" Command="{Binding TogglePinToDesktopCommand}" />
                    <Separator />
                    <MenuItem Header="设置" Command="{Binding OpenSettingsCommand}" />
                    <Separator />
                    <MenuItem Header="退出" Command="{Binding ExitAllCommand}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
