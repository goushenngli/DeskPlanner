<Window x:Class="DesktopCalendar.Views.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:DesktopCalendar.Views"
        xmlns:helpers="clr-namespace:DesktopCalendar.Helpers"
        xmlns:calendarDayCell="clr-namespace:CalendarDayCell.Views;assembly=CalendarDayCell"
        mc:Ignorable="d"
        Title="CalendarWindow" Height="750" Width="800"
        AllowsTransparency="True"
        WindowStyle="None"
        Icon="{Binding AppSettings.TrayIconSource}"
        helpers:WindowPenetrateHelper.IsPenetratable="{Binding IsMousePenetrate}"
        helpers:DesktopEmbedHelper.IsEmbeddedInDesktop="{Binding IsPinToDesktop}"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <!-- ResizeBorderThickness 指定四周感应调整大小的边框宽度 -->
        <!-- CaptionHeight 设置标题栏拖拽区域高度（如果不需要可设为 0） -->
        <WindowChrome ResizeBorderThickness="6"
                      CaptionHeight="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Background>
        <SolidColorBrush Color="Black" Opacity="{Binding AppSettings.Opacity}"/>
    </Window.Background>
    <Border BorderBrush="#444444" BorderThickness="1" CornerRadius="8">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <!-- 顶部工具栏 -->
                <RowDefinition Height="Auto"/>
                <!-- 星期表头 -->
                <RowDefinition Height="Auto"/>
                <!-- 42天日历网格 -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="&lt;" Width="30" Height="30" Margin="0,0,5,0" Command="{Binding PreviousMonthCommand}"/>
                    <TextBlock Text="{Binding CurrentMonthText}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                    <Button Content="&gt;" Width="30" Height="30" Margin="5,0,0,0" Command="{Binding NextMonthCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="设置" Width="60" Height="30" Margin="0,0,10,0" Click="set_Click"/>
                    <Button Content="今天" Width="60" Height="30" Margin="0,0,10,0"/>
                    <Button Content="✕" Width="30" Height="30" Margin="0,0,10,0" Click="Button_Click"/>
                </StackPanel>
            </Grid>
            <UniformGrid Grid.Row="1" Columns="7" Margin="0,5">
                <TextBlock Text="一" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                <TextBlock Text="二" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                <TextBlock Text="三" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                <TextBlock Text="四" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                <TextBlock Text="五" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                <TextBlock Text="六" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                <TextBlock Text="日" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
            </UniformGrid>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding DaysList}">
                <!-- 将容器面板设置为 7 列的 UniformGrid -->
                <ItemsControl.ItemsPanel >
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" Rows="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <calendarDayCell:CalendarDayCellView>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="AddRequested">
                                    <i:InvokeCommandAction
                                        Command="{Binding DataContext.AddTodoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </calendarDayCell:CalendarDayCellView>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
