<UserControl x:Class="CalendarDayCell.Views.CalendarDayCellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CalendarDayCell.Views"
             xmlns:todoCalendar="clr-namespace:TodoCalendar.Views;assembly=TodoCalendar"
             xmlns:viewModels="clr-namespace:CalendarDayCell.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="150"
             d:DataContext="{d:DesignInstance Type=viewModels:CalendarDayCellViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Border x:Name="RootBorder" CornerRadius="6"
            BorderBrush="#555555"
            BorderThickness="1"
            Background="#50222830"
            Padding="4"
            Margin="3">
        <Grid>
            <Grid.RowDefinitions>
            <!-- 顶部日期栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 待办事项栏 -->
            <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding DayNumber}" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                    <!-- 鼠标滑过时可见 -->
                    <Button Content="+"
                            Foreground="White"
                            FontSize="12"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="5,0"
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            Cursor="Hand"
                            Visibility="{Binding IsMouseOver, ElementName=RootBorder,
                                                 Converter={StaticResource BoolToVis}}"
                            Click="RequestAddTodo"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding FestivalName}" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBlock Text="{Binding WorkStatusText}" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Vertical">
                        <ItemsControl ItemsSource="{Binding TodoItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <todoCalendar:TodoItemView Margin="5,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
